# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# Sur Vercel : Project → Settings → Environment Variables.

# Adresse publique du site (sert aux aperçus WhatsApp / Open Graph et au sitemap).
NEXT_PUBLIC_SITE_URL=https://elvira-jacob.vercel.app

# --- Stockage des RSVP dans Google Sheets (voir docs/GOOGLE_SETUP.md) ---
# Sans ces trois variables, le site enregistre les réponses dans .data/ (mode local).
# En production sur Vercel, elles sont OBLIGATOIRES : le disque de Vercel n'est pas persistant.
GOOGLE_SERVICE_ACCOUNT_EMAIL=rsvp-site@mon-projet.iam.gserviceaccount.com
# Clé privée du compte de service, sur une seule ligne avec des \n (copiée telle quelle depuis le fichier JSON).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Identifiant de la Sheet « RSVP Elvira & Jacob » : la partie entre /d/ et /edit dans son URL.
GOOGLE_SHEET_ID=

# --- Espace administrateur /admin/rsvp (Auth.js + Google OAuth) ---
# Générer avec : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails autorisés, séparés par des virgules.
ADMIN_EMAILS=empireadrianlopes@gmail.com
